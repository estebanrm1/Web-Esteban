---
import Base from '../layouts/Base.astro';
import { person, pitch, experience, caseStudies, skills, languages, certificates, currentStudy, site } from '../data/profile';
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base title={`CV — ${person.name}, ${person.role}`} description={`Currículum de ${person.name}: ${person.role}. ${pitch.headline}`}>
  <nav class="toolbar" aria-label="Acciones del CV">
    <a href="/">← Volver al portfolio</a>
    <a class="btn btn--accent" href={person.cvPdf} download>Descargar PDF</a>
  </nav>

  <main id="contenido" class="cv">
    <header class="cv-head">
      <div>
        <h1>{person.name}</h1>
        <p class="cv-role">{person.role}</p>
        <p class="cv-focus">{person.focus}</p>
      </div>
      <ul class="cv-contact">
        <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
        <li><a href={person.whatsapp}>{person.phoneDisplay}</a></li>
        <li><a href={person.linkedin}>{host(person.linkedin)}</a></li>
        <li><a href={site.url}>{host(site.url)}</a></li>
        <li>{person.location}</li>
        <li>{person.modality}</li>
      </ul>
    </header>

    <div class="cols">
      <div class="main">
        <section>
          <h2>Perfil profesional</h2>
          <p>{pitch.summary}</p>
        </section>

        <section>
          <h2>Experiencia laboral</h2>
          {experience.map((r) => (
            <article class="item">
              <div class="row">
                <h3>{r.title} <span>· {r.company}</span></h3>
                <p class="date">{r.period}</p>
              </div>
              <ul class="bullets">
                {r.points.map((p) => <li>{p}</li>)}
              </ul>
            </article>
          ))}
        </section>

        <section>
          <h2>Proyectos destacados</h2>
          {caseStudies.map((c) => (
            <article class="item">
              <h3>{c.title}</h3>
              <p>{c.solution}</p>
              <p class="muted">{c.stack.join(' · ')}</p>
            </article>
          ))}
        </section>
      </div>
      <aside>
        <section>
          <h2>Habilidades</h2>
          {skills.map((g) => (
            <div class="item">
              <h3>{g.group}</h3>
              <p>{g.items.join(', ')}</p>
            </div>
          ))}
        </section>

        <section>
          <h2>Formación</h2>
          <div class="item">
            <h3>{currentStudy.title} <span>· en curso</span></h3>
            <p class="muted">{currentStudy.program}</p>
          </div>
          {certificates.map((c) => (
            <div class="item">
              <h3>{c.title}</h3>
              <p class="muted">{c.issuer} · {c.date}</p>
            </div>
          ))}
        </section>

        <section>
          <h2>Idiomas</h2>
          {languages.map((l) => (
            <div class="item">
              <h3>{l.name}</h3>
              <p class="muted">{l.level}</p>
            </div>
          ))}
        </section>
      </aside>
    </div>
  </main>
</Base>

<style>
  :global(body) {
    background: var(--paper-2);
  }
  .toolbar {
    max-width: 210mm;
    margin: 1.5rem auto 1rem;
    padding-inline: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .cv {
    /* El CV siempre en claro, independiente del tema */
    --paper: #ffffff;
    --ink: #17131c;
    --ink-2: #3f3946;
    --ink-3: #635b6a;
    --line: #ddd5e3;
    --accent: #6a2a85;
    color: var(--ink);
    background: var(--paper);
    width: min(100% - 2rem, 210mm);
    margin: 0 auto 3rem;
    padding: 10mm 12mm;
    box-shadow: var(--shadow);
    font-size: 8.7pt;
    line-height: 1.4;
  }
  .cv-head {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 4mm;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 2mm;
  }
  h1 {
    font-size: 24pt;
    letter-spacing: -0.03em;
  }
  .cv-role {
    color: var(--accent);
    font-weight: 700;
    font-size: 12pt;
    margin-top: 1.5mm;
  }
  .cv-focus {
    color: var(--ink-3);
    font-size: 9pt;
    margin-top: 0.5mm;
  }
  .cv-contact {
    list-style: none;
    padding: 0;
    text-align: right;
    font-size: 8.4pt;
    color: var(--ink-2);
  }
  .cv-contact a {
    text-decoration: none;
    display: inline-block;
    min-height: 24px;
  }
  @media print {
    .cv-contact a {
      min-height: 0;
    }
  }
  h2 {
    font-size: 8.4pt;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin: 3.5mm 0 1.6mm;
    font-family: var(--font-body);
    font-weight: 700;
  }
  section > p {
    color: var(--ink-2);
  }
  /* Float en lugar de grid: Chrome puede partirlo entre páginas al imprimir */
  .cols {
    display: flow-root;
  }
  .cols > .main {
    float: left;
    width: 64%;
  }
  .cols > aside {
    float: right;
    width: 32%;
  }
  .item {
    margin-bottom: 2.2mm;
    break-inside: avoid;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .date {
    flex: none;
    font-size: 8pt;
    font-weight: 600;
    color: var(--accent);
  }
  h3 {
    font-size: 9.6pt;
    letter-spacing: -0.01em;
  }
  h3 span {
    font-weight: 500;
    color: var(--ink-3);
    font-family: var(--font-body);
  }
  .item p {
    color: var(--ink-2);
  }
  .bullets {
    margin-top: 1mm;
    padding-left: 3.5mm;
    color: var(--ink-2);
  }
  .bullets li + li {
    margin-top: 0.6mm;
  }
  .muted {
    color: var(--ink-3) !important;
    font-size: 8.2pt;
  }
  .cv a {
    color: inherit;
  }
  @media (max-width: 700px) {
    .cv {
      padding: 1.5rem;
      font-size: 0.95rem;
    }
    .cv-head {
      display: grid;
      grid-template-columns: 1fr;
    }
    .cols > aside,
    .cols > .main {
      float: none;
      width: auto;
    }
    .cv-contact {
      text-align: left;
    }
  }
  @media print {
    @page {
      size: A4;
      margin: 0;
    }
    :global(body) {
      background: #fff;
    }
    :global(.skip-link),
    .toolbar {
      display: none;
    }
    .cv {
      width: 210mm;
      margin: 0;
      box-shadow: none;
    }
  }
</style>
