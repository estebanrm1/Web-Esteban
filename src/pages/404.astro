---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada — Esteban Molina" noindex>
  <main id="contenido" class="nf container">
    <p class="eyebrow">Error 404</p>
    <h1>Esta página no existe.</h1>
    <p>Puede que el enlace esté desactualizado. Volvé al inicio para ver mi perfil y proyectos.</p>
    <a class="btn btn--accent" href="/">Ir al inicio</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100dvh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.2rem;
  }
  h1 {
    font-size: var(--step-4);
  }
  p:not(.eyebrow) {
    color: var(--ink-2);
    max-width: 50ch;
  }
</style>
