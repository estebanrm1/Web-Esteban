---
import Icon from './Icon.astro';
import { person, site } from '../data/profile';
import { execSync } from 'node:child_process';

const year = new Date().getFullYear();

// Hash del commit publicado: Netlify lo expone como COMMIT_REF; en local se lee de git.
let commit = process.env.COMMIT_REF ?? '';
if (!commit) {
  try {
    commit = execSync('git rev-parse HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
  } catch {}
}
const short = commit.slice(0, 7);
const builtAt = new Date().toISOString().slice(0, 10);
---

<footer class="footer">
  <div class="container inner">
    <p class="big">¿Buscás a alguien que una negocio y tecnología? <a href="#contacto">Escribime.</a></p>
    <div class="row">
      <p>© {year} {person.name}. Diseñado y desarrollado por mí.</p>
      <ul>
        <li><a href={person.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" label="LinkedIn" /></a></li>
        <li><a href={person.github} target="_blank" rel="noopener noreferrer"><Icon name="github" label="GitHub" /></a></li>
        <li><a href={person.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" label="WhatsApp" /></a></li>
        <li><a href={`mailto:${person.email}`}><Icon name="mail" label="Email" /></a></li>
      </ul>
      <p><a href={site.repo} target="_blank" rel="noopener noreferrer">Código fuente</a> · <a href="#inicio">Volver arriba ↑</a></p>
    </div>
    <p class="build">
      <span class="ok" aria-hidden="true"></span>
      <span>astro · netlify</span>
      {short && (
        <a href={`${site.repo}/commit/${commit}`} target="_blank" rel="noopener noreferrer">
          build {short}<span class="sr-only"> (ver commit en GitHub, abre en una pestaña nueva)</span>
        </a>
      )}
      <span>deploy <time datetime={builtAt}>{builtAt}</time></span>
    </p>
  </div>
</footer>

<style>
  .footer {
    /* Siempre oscuro, en ambos temas */
    --f-bg: #0d0b10;
    --f-fg: #f5f1ea;
    --f-accent: #d7b2f5;
    background: var(--f-bg);
    color: var(--f-fg);
    padding-block: clamp(3.5rem, 2rem + 5vw, 6rem) 2rem;
  }
  .inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .big {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.1;
    max-width: 22ch;
  }
  .big a {
    color: var(--f-accent);
    text-decoration-thickness: 2px;
  }
  .row p a {
    display: inline-block;
    padding-block: 0.6rem;
  }
  .row p a:hover {
    color: var(--f-fg);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--f-fg) 78%, transparent);
  }
  .build {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.1rem;
    margin-top: -2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--f-fg) 72%, transparent);
  }
  .build a {
    display: inline-block;
    padding-block: 0.45rem;
    color: inherit;
  }
  .build a:hover {
    color: var(--f-accent);
  }
  .ok {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #6fd3a0;
    box-shadow: 0 0 0 3px rgb(111 211 160 / 0.18);
  }
  ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }
  ul a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--f-fg);
    transition: background-color 0.2s var(--ease);
  }
  ul a:hover {
    background: rgb(255 255 255 / 0.1);
  }
  ul :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
