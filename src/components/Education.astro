---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { currentStudy, certificates } from '../data/profile';

// Versión grande optimizada para el visor (se carga solo al abrirlo).
const full = await Promise.all(
  certificates.map((c) => getImage({ src: c.image, width: 1600, format: 'webp', quality: 78 })),
);
---

<section id="formacion" class="section" aria-labelledby="formacion-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">05 · Formación</p>
      <h2 id="formacion-title" class="section-title">Aprendizaje continuo, certificado y aplicado.</h2>
    </header>

    <div class="layout">
      <aside class="current" data-reveal>
        <p class="now">En curso</p>
        <h3>{currentStudy.title}</h3>
        <p class="program">{currentStudy.program}</p>
        <p class="text">{currentStudy.text}</p>
        <ul class="tags" aria-label="Áreas">
          <li class="tag">IA para Marketing</li>
          <li class="tag">IA para Ventas</li>
          <li class="tag">IA para RR. HH.</li>
          <li class="tag">IA para Finanzas</li>
        </ul>
      </aside>

      <div class="certs">
        <h3 class="certs-title" id="certs-title">Certificaciones</h3>
        <ul aria-labelledby="certs-title">
          {certificates.map((c, i) => (
            <li class="cert" data-reveal style={`--d:${i}`}>
              <button
                class="cert-btn"
                type="button"
                data-cert-open
                data-src={full[i].src}
                data-title={c.title}
                aria-haspopup="dialog"
              >
                <Image src={c.image} alt="" width={420} quality={65} loading="lazy" />
                <span class="cert-zoom" aria-hidden="true"><Icon name="expand" /></span>
                <span class="sr-only">Ver certificado {c.title} ampliado</span>
              </button>
              <div class="cert-info">
                <p class="cert-issuer">{c.issuer}</p>
                <h4>{c.title}</h4>
                <p class="cert-date"><time datetime={c.dateISO}>{c.date}</time></p>
                <p class="cert-detail">{c.detail}</p>
                {c.verifyUrl && (
                  <a class="cert-verify" href={c.verifyUrl} target="_blank" rel="noopener noreferrer">
                    Verificar autenticidad <Icon name="arrow-up-right" /><span class="sr-only"> de {c.title} (abre en una pestaña nueva)</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <dialog class="viewer" data-cert-dialog aria-labelledby="viewer-title">
    <div class="viewer-bar">
      <p id="viewer-title" class="viewer-title" data-cert-title></p>
      <button class="viewer-close" type="button" data-cert-close>
        <Icon name="close" /><span class="sr-only">Cerrar</span>
      </button>
    </div>
    <img data-cert-img alt="" width="1600" height="1130" decoding="async" />
  </dialog>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
    align-items: start;
  }
  .current {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--paper);
  }
  .current .now {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--paper);
    opacity: 0.85;
  }
  .current .now::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #6fd3a0;
  }
  .current h3 {
    font-size: var(--step-3);
  }
  .program {
    font-weight: 600;
    opacity: 0.85;
  }
  .text {
    font-size: var(--step--1);
    line-height: 1.6;
    opacity: 0.85;
    margin-bottom: 0.4rem;
  }
  :global([data-theme='dark']) .current {
    background: var(--accent-soft);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }
  :global([data-theme='dark']) .current .now,
  :global([data-theme='dark']) .current .tag {
    color: var(--ink);
  }
  :global([data-theme='dark']) .current .tag {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .current .tag {
    background: transparent;
    color: var(--paper);
    border-color: color-mix(in srgb, var(--paper) 30%, transparent);
  }

  .cert-verify {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    width: fit-content;
    margin-top: 0.2rem;
    padding-block: 0.3rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--accent);
  }
  .cert-verify :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }
  .certs-title {
    font-size: var(--step-0);
    font-family: var(--font-body);
    letter-spacing: 0;
    color: var(--ink-3);
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .certs ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .cert {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.25rem;
    padding: 1rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    align-items: center;
  }
  .cert-btn {
    position: relative;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    cursor: zoom-in;
    background: #fff;
  }
  .cert-btn :global(img) {
    width: 100%;
    aspect-ratio: 1.414;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .cert-btn:hover :global(img) {
    transform: scale(1.05);
  }
  .cert-zoom {
    position: absolute;
    right: 0.4rem;
    bottom: 0.4rem;
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
  }
  .cert-zoom :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }
  .cert-info {
    display: grid;
    gap: 0.2rem;
  }
  .cert-issuer {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }
  .cert-info h4 {
    font-size: var(--step-1);
  }
  .cert-date {
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 600;
  }
  .cert-detail {
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.5;
  }

  .viewer {
    width: min(96vw, 1100px);
    max-height: 92dvh;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .viewer::backdrop {
    background: rgb(10 8 14 / 0.72);
    backdrop-filter: blur(4px);
  }
  .viewer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.6rem 0.6rem 1.2rem;
    border-bottom: 1px solid var(--line);
  }
  .viewer-title {
    font-weight: 600;
  }
  .viewer-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    cursor: pointer;
  }
  .viewer-close :global(svg) {
    width: 1.2rem;
  }
  .viewer img {
    width: 100%;
    height: auto;
    max-height: calc(92dvh - 4rem);
    object-fit: contain;
    background: #fff;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .current {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .cert {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-cert-dialog]')!;
  const img = dialog.querySelector<HTMLImageElement>('[data-cert-img]')!;
  const title = dialog.querySelector<HTMLElement>('[data-cert-title]')!;

  document.querySelectorAll<HTMLButtonElement>('[data-cert-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      img.src = btn.dataset.src!;
      img.alt = `Certificado: ${btn.dataset.title}`;
      title.textContent = btn.dataset.title!;
      dialog.showModal();
    });
  });
  dialog.querySelector('[data-cert-close]')!.addEventListener('click', () => dialog.close());
  // Cerrar al hacer clic fuera del contenido.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
