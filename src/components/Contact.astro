---
import Icon from './Icon.astro';
import { person } from '../data/profile';

const waHref = `${person.whatsapp}?text=${encodeURIComponent(person.whatsappMessage)}`;
---

<section id="contacto" class="section contact" aria-labelledby="contacto-title">
  <div class="container grid">
    <header class="section-head head" data-reveal>
        <p class="eyebrow">06 · Contacto</p>
        <h2 id="contacto-title" class="section-title">¿Tenés un puesto o un desafío de eCommerce? Hablemos.</h2>
        <p class="lede">La forma más rápida es WhatsApp: respondo personalmente. Si preferís otro canal, también estoy acá.</p>
    </header>

    <div class="wa" data-glow data-reveal style="--d:1">
      <div class="wa-bar" aria-hidden="true">
        <i></i><i></i><i></i>
        <span>mensaje_directo</span>
      </div>
      <div class="wa-body">
        <p class="wa-status"><span class="wa-dot" aria-hidden="true"></span> respuesta directa · {person.location}</p>
        <h3 class="wa-title">Escribime por WhatsApp</h3>
        <p class="wa-number">{person.phoneDisplay}</p>
        <figure class="wa-preview">
          <figcaption>Mensaje sugerido</figcaption>
          <blockquote>{person.whatsappMessage}</blockquote>
        </figure>
        <a class="btn btn--accent wa-btn" href={waHref} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> Abrir chat
          <span class="sr-only"> de WhatsApp con {person.name} (abre en una pestaña nueva)</span>
        </a>
        <p class="wa-hint">Podés editar el mensaje antes de enviarlo.</p>
      </div>
    </div>
    <div class="others">
      <ul class="channels">
        <li data-reveal>
          <span class="ch-k">email</span>
          <div class="ch-row">
            <a class="ch-v" href={`mailto:${person.email}`}>{person.email}</a>
            <button class="copy" type="button" data-copy={person.email}>
              <Icon name="copy" class="i-copy" /><Icon name="check" class="i-check" />
              <span data-copy-label>Copiar</span>
            </button>
          </div>
        </li>
        <li data-reveal style="--d:1">
          <span class="ch-k">linkedin</span>
          <a class="ch-v" href={person.linkedin} target="_blank" rel="noopener noreferrer">
            {person.linkedinHandle}<span class="sr-only"> (abre en una pestaña nueva)</span>
          </a>
        </li>
        <li data-reveal style="--d:2">
          <span class="ch-k">cv</span>
          <a class="ch-v" href={person.cvPdf} download>Descargar PDF</a>
        </li>
      </ul>
      <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
    </div>

  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    grid-template-areas:
      'head wa'
      'others wa';
    grid-template-rows: auto 1fr;
    gap: 0 clamp(2.5rem, 1rem + 5vw, 6rem);
    align-items: start;
  }
  .head {
    grid-area: head;
  }
  .wa {
    grid-area: wa;
  }
  .others {
    grid-area: others;
  }
  .channels {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .channels li {
    display: grid;
    gap: 0.15rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }
  .channels li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .ch-k {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ink-3);
  }
  .ch-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .ch-v {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 550;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .ch-v:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--ink);
  }
  .copy :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }
  .copy :global(.i-check),
  .copy.is-done :global(.i-copy) {
    display: none;
  }
  .copy.is-done :global(.i-check) {
    display: block;
    color: var(--signal);
  }

  /* Tarjeta principal de WhatsApp */
  .wa {
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .wa-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .wa-bar i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--line);
  }
  .wa-bar span {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
  }
  .wa-body {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.4rem, 1rem + 2vw, 2.2rem);
  }
  .wa-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-2);
  }
  .wa-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
  }
  .wa-title {
    font-size: var(--step-3);
  }
  .wa-number {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .wa-preview {
    margin: 0.4rem 0 0.2rem;
    display: grid;
    gap: 0.4rem;
  }
  .wa-preview figcaption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
  }
  .wa-preview figcaption::before {
    content: '# ';
    color: var(--accent);
  }
  .wa-preview blockquote {
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: 4px 14px 14px 14px;
    background: var(--accent-soft);
    color: var(--ink);
    font-size: var(--step--1);
    line-height: 1.55;
  }
  .wa-btn {
    justify-self: start;
    margin-top: 0.4rem;
  }
  .wa-hint {
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'head'
        'wa'
        'others';
      grid-template-rows: auto;
      gap: 2.5rem;
    }
    .wa-btn {
      justify-self: stretch;
    }
  }
</style>

<script>
  // Copiar email al portapapeles (con alternativa mailto si el navegador no lo permite).
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]')!;
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('[data-copy-label]')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.classList.add('is-done');
        label.textContent = 'Copiado';
        copyStatus.textContent = 'Email copiado al portapapeles';
        setTimeout(() => {
          btn.classList.remove('is-done');
          label.textContent = 'Copiar';
        }, 2200);
      } catch {
        location.href = `mailto:${btn.dataset.copy}`;
      }
    });
  });
</script>
