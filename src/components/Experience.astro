---
import { experience } from '../data/profile';
---

<section id="experiencia" class="section" aria-labelledby="experiencia-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">02 · Experiencia</p>
      <h2 id="experiencia-title" class="section-title">Resultados en operación real, no solo en proyectos de práctica.</h2>
    </header>

    <ol class="roles">
      {experience.map((r, i) => (
        <li class:list={['role', { current: i === 0 }]} data-reveal>
          <div class="when">
            <p class="period">
              <time datetime={r.start}>{r.period.split(' — ')[0]}</time> — {r.end ? <time datetime={r.end}>{r.end}</time> : 'Presente'}
            </p>
            {!r.end && <span class="now">en curso</span>}
          </div>
          <div class="what">
            <h3>{r.title}</h3>
            <p class="company">{r.company}</p>
            <ul class="points">
              {r.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .roles {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .role {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 1.5rem clamp(1.5rem, 1rem + 3vw, 4rem);
    padding-block: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem);
    border-bottom: 1px solid var(--line);
  }
  .when {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .now {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--signal);
  }
  .now::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
  }
  .what h3 {
    font-size: var(--step-2);
  }
  .current .what h3 {
    font-size: var(--step-3);
  }
  .company {
    margin-top: 0.35rem;
    color: var(--accent);
    font-weight: 600;
  }
  .points {
    margin-top: 1.1rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
    max-width: 68ch;
  }
  .points li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-2);
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.6rem;
    height: 1px;
    background: var(--accent);
  }
  @media (max-width: 760px) {
    .role {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .when {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
  }
</style>
