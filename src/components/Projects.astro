---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { projects, caseStudies } from '../data/profile';
---

<section id="proyectos" class="section" aria-labelledby="proyectos-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">03 · Proyectos</p>
      <h2 id="proyectos-title" class="section-title">Problemas de negocio resueltos con código.</h2>
      <p class="lede">Herramientas internas que construí en Yuhmak y sitios publicados para clientes de A.M Soluciones Web.</p>
    </header>

    <h3 class="sub" id="casos-title">Casos destacados</h3>
    <ol class="cases" aria-labelledby="casos-title">
      {caseStudies.map((c, i) => (
        <li class="case" data-reveal style={`--d:${i}`}>
          <p class="case-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <p class="case-ctx">{c.context}</p>
          <h4>{c.title}</h4>
          <dl class="case-body">
            <div>
              <dt>Problema</dt>
              <dd>{c.problem}</dd>
            </div>
            <div>
              <dt>Solución</dt>
              <dd>{c.solution}</dd>
            </div>
          </dl>
          <ul class="tags" aria-label="Tecnologías">
            {c.stack.map((t) => <li class="tag">{t}</li>)}
          </ul>
        </li>
      ))}
    </ol>
    <p class="note">Proyectos internos: el código y las pantallas son confidenciales. Con gusto los explico en una entrevista.</p>

    <h3 class="sub" id="sitios-title">Sitios publicados</h3>
    <ol class="list" aria-labelledby="sitios-title">
      {projects.map((p, i) => (
        <li class="project" data-reveal>
          <a class="shot" href={p.demo} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
            <span class="chrome" aria-hidden="true"><i></i><i></i><i></i><span class="url">{new URL(p.demo).host}</span></span>
            <Image
              src={p.image}
              alt=""
              widths={[400, 560, 760, 1100]}
              sizes="(max-width: 860px) 100vw, 560px"
              quality={70}
              loading="lazy"
            />
          </a>
          <div class="info">
            <p class="meta"><span>{String(i + 1).padStart(2, '0')}</span> {p.kind}</p>
            <h4>{p.title}</h4>
            <p class="desc">{p.description}</p>
            <ul class="tags" aria-label="Tecnologías">
              {p.stack.map((t) => <li class="tag">{t}</li>)}
            </ul>
            <p class="sr-only">{p.imageAlt}</p>
            <div class="links">
              <a class="btn btn--ghost" href={p.demo} target="_blank" rel="noopener noreferrer">
                Ver sitio <Icon name="arrow-up-right" /><span class="sr-only"> de {p.title} (abre en una pestaña nueva)</span>
              </a>
              {p.repo && (
                <a class="btn btn--ghost" href={p.repo} target="_blank" rel="noopener noreferrer">
                  <Icon name="github" /> Código<span class="sr-only"> de {p.title} en GitHub (abre en una pestaña nueva)</span>
                </a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .sub {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink-3);
    margin-bottom: 1.1rem;
  }
  .cases {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .case {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.4rem, 1rem + 1.2vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .case:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .case-n {
    position: absolute;
    top: 0.6rem;
    right: 1.1rem;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent-soft);
    letter-spacing: -0.04em;
  }
  .case-ctx {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    position: relative;
    padding-right: 4rem;
  }
  .case h4 {
    font-size: var(--step-2);
    position: relative;
    max-width: 16ch;
  }
  .case-body {
    display: grid;
    gap: 0.75rem;
    margin-block: 0.4rem 0.6rem;
    flex: 1;
  }
  .case-body dt {
    font-size: var(--step--1);
    font-weight: 600;
  }
  .case-body dd {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .note {
    margin: 1rem 0 clamp(3rem, 2rem + 3vw, 4.5rem);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem) clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
  }
  .project {
    display: grid;
    gap: 1.4rem;
    align-content: start;
  }
  .shot {
    display: block;
    text-decoration: none;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }
  .chrome i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--line);
  }
  .url {
    margin-left: 0.6rem;
    font-size: 0.72rem;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .shot :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    transition: transform 0.8s var(--ease);
  }
  .project:hover .shot {
    transform: translateY(-4px);
  }
  .project:hover .shot :global(img) {
    transform: scale(1.025);
  }
  .info {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .meta {
    font-size: var(--step--1);
    color: var(--ink-3);
    font-weight: 500;
  }
  .meta span {
    color: var(--accent);
    font-weight: 600;
    margin-right: 0.4rem;
  }
  .info h4 {
    font-size: var(--step-2);
  }
    .desc {
    color: var(--ink-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .links .btn {
    min-height: 2.75rem;
    padding: 0.5rem 1.05rem;
  }
  @media (max-width: 1000px) {
    .cases {
      grid-template-columns: 1fr;
    }
    .case h4 {
      max-width: none;
    }
  }
  @media (max-width: 860px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
