---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/profile/esteban-molina-2026.jpg';
import { person, pitch, highlights } from '../data/profile';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="status" data-reveal>
        <span class="dot" aria-hidden="true"></span>
        {person.location} · {person.modality}
      </p>

      <h1 id="hero-title" class="title" data-reveal style="--d:1">
        <span class="name">{person.name}</span>
        <span class="role">{person.role}<span class="focus">{person.focus}</span></span>
      </h1>

      <p class="headline" data-reveal style="--d:2">{pitch.headline}</p>
      <p class="summary" data-reveal style="--d:3">{pitch.summary}</p>

      <div class="cta" data-reveal style="--d:4">
        <a class="btn btn--accent" href="#experiencia">Ver experiencia <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href={person.cvPdf} download><Icon name="download" /> Descargar CV</a>
        <a class="btn btn--ghost" href="#contacto">Contactar</a>
      </div>

      <ul class="social" aria-label="Perfiles" data-reveal style="--d:5">
        <li>
          <a href={person.linkedin} target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" /> LinkedIn<span class="sr-only"> (abre en una pestaña nueva)</span>
          </a>
        </li>
        <li>
          <a href={person.github} target="_blank" rel="noopener noreferrer">
            <Icon name="github" /> GitHub<span class="sr-only"> (abre en una pestaña nueva)</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${person.email}`}><Icon name="mail" /> {person.email}</a>
        </li>
      </ul>
    </div>

    <figure class="portrait" data-reveal style="--d:2">
      <Picture
        src={portrait}
        alt="Retrato de Esteban Molina sonriendo, con un suéter mostaza."
        widths={[240, 400, 500]}
        sizes="(max-width: 860px) 104px, 420px"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading="eager"
        fetchpriority="high"
        quality={72}
      />
      <figcaption class="badge">
        <span class="badge-k">Actualmente</span>
        <span class="badge-v">Analista de Operaciones eCommerce · {person.currentEmployer}</span>
      </figcaption>
    </figure>
  </div>

  <div class="container">
    <ul class="facts" aria-label="De un vistazo">
      {highlights.map((h, i) => (
        <li class="fact" data-reveal style={`--d:${i}`}>
          <strong class="fact-v">{h.value}</strong>
          <span class="fact-l">{h.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem) clamp(3rem, 2rem + 4vw, 5rem);
    isolation: isolate;
  }
  .hero::before {
    /* Trama sutil: retícula editorial */
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--line) 55%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--line) 55%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 30%, #000 20%, transparent 75%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-2);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 60%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: pulse 2.4s var(--ease) infinite;
    }
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .title {
    margin-top: 1.4rem;
    display: grid;
    gap: 0.6rem;
  }
  .name {
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .role {
    font-size: var(--step-2);
    font-weight: 550;
    color: var(--accent);
    letter-spacing: -0.015em;
  }
  .role {
    text-wrap: wrap;
  }
  .focus {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72em;
    color: var(--ink-3);
  }
  .headline {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 550;
    line-height: 1.35;
    max-width: 34ch;
  }
  .summary {
    margin-top: 0.9rem;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .social {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    list-style: none;
    padding: 0;
    font-size: var(--step--1);
  }
  .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.4rem;
  }
  .social a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .social :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .portrait {
    position: relative;
    justify-self: end;
    width: min(100%, 26rem);
  }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    filter: saturate(0.92) contrast(1.02);
  }
  .portrait::before {
    content: '';
    position: absolute;
    inset: 1.1rem -1.1rem -1.1rem 1.1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
    z-index: -1;
  }
  .badge {
    position: absolute;
    left: -1.25rem;
    bottom: 1.5rem;
    display: grid;
    gap: 0.1rem;
    max-width: 16rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    font-size: var(--step--1);
    line-height: 1.35;
  }
  .badge-k {
    color: var(--accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
  }
  .badge-v {
    font-weight: 600;
  }

  .facts {
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    list-style: none;
    padding: 0;
  }
  .fact {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.25rem 1.25rem 0 0;
  }
  .fact + .fact {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }
  .fact-v {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .fact-l {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      grid-row: 1;
      justify-self: start;
      width: 6.5rem;
    }
    .portrait::before {
      inset: 0.4rem -0.4rem -0.4rem 0.4rem;
      border-radius: var(--radius);
    }
    .portrait :global(img) {
      aspect-ratio: 1;
      border-radius: var(--radius);
    }
    .hero-grid {
      gap: 1.5rem;
    }
    .badge {
      left: calc(100% + 1.25rem);
      bottom: 50%;
      transform: translateY(50%);
      width: max-content;
      max-width: 13rem;
    }
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .fact:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .fact:nth-child(n + 3) {
      border-top: 1px solid var(--line);
      margin-top: 1.25rem;
    }
  }
  @media (max-width: 520px) {
    .badge {
      display: none;
    }
    .cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
